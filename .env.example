GOOGLE_APPLICATION_CREDENTIALS=
# PostgreSQL privat. DSN berisi password; jangan kirim ke chat/commit.
DATABASE_URL=
# Database terpisah, hanya untuk pengujian otomatis.
TEST_DATABASE_URL=
