{
  "id": "sigapi-validation-demo",
  "name": "SIGAPI persistent intake",
  "description": "Private WhatsApp intake with durable spool and reply outbox; no publication.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["allowSenders"],
    "properties": {
      "allowSenders": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
      "outboundRecipients": { "type": "array", "maxItems": 2, "items": { "type": "string", "pattern": "^\\+[1-9][0-9]{7,14}$" } }
    }
  }
}
