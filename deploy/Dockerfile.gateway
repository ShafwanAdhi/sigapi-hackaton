FROM node:24.22.1-bookworm-slim
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=384 OPENCLAW_STATE_DIR=/gateway/state
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg git && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/openclaw
COPY deploy/gateway-package.json ./package.json
COPY deploy/gateway-package-lock.json ./package-lock.json
RUN npm ci --omit=dev --no-audit --no-fund --ignore-scripts
COPY openclaw-plugin /app/openclaw-plugin
COPY deploy/gateway-init.mjs /app/gateway-init.mjs
RUN mkdir -p /gateway/state && chown -R node:node /gateway
USER node
WORKDIR /gateway
CMD ["node","/opt/openclaw/node_modules/openclaw/openclaw.mjs","gateway"]
